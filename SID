            f"Score: {medico['score_desempenho']:.0f}/100\n\n"
            f"MÉTRICAS PRINCIPAIS:\n"
            f"• Atendimentos: {medico['num_atendimentos']}\n"
            f"• Eficiência: {medico['eficiencia']:.1f} pac/hora\n"
            f"• Ocupação: {medico['taxa_ocupacao']:.1f}%\n"
            f"• Tempo médio: {medico['tempo_medio_consulta']:.1f} min\n"
            f"• Corresp.: {medico['taxa_correspondencia']:.1f}%\n"
            f"• Horário pico: {medico['horario_pico']}\n\n"
