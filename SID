                    else:
                        mostrar_graficos_simulacao(estado_simulacao["dados_historicos"], "Simulação Atual")
                        continuar = False
                else:
                    encontrou_simulacao = False
                    for sim in estado_simulacao["resultados_simulacoes"]:
                        config = sim["configuracao"]
                        timestamp = sim["timestamp"]
                        data_formatada = datetime.strptime(timestamp, "%Y-%m-%d %H:%M:%S").strftime("%d/%m/%Y %H:%M:%S")
                        texto_sim = f"λ={config['lambda_chegada']} M={config['num_medicos']} {data_formatada}"
                        
