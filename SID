# Parâmetros da aplicação
NUM_MEDICOS = 2
TAXA_CHEGADA = 10 / 60
TEMPO_MEDIO_CONSULTA = 15
TEMPO_SIMULACAO = 8 * 60
DISTRIBUICAO_TEMPO_CONSULTA = "exponential"
TEMPO_MAX_ESPERA = 60
PROB_DESISTENCIA = 0.3

# Prioridades
PRIORIDADES = {
    "URGENTE": 1,
    "ALTA": 2,
    "NORMAL": 3,
    "BAIXA": 4
}

# Estado global da simulação
estado_simulacao = {
    "pessoas_dados": {},
    "paciente_selecionado": None,
    "historico_atendimentos": [],
    "fila_espera": [],
    "tempo_atual": 0,
    "simulacao_ativa": False,
    "velocidade": 1.0,
    "medicos": [],
    "proximo_paciente_tempo": 0,
    "pacientes_disponiveis": [],
    "pacientes_desistentes": []
}

def carregar_pacientes():
    try:
        with open("pacientes.json", "r", encoding="utf-8") as f:
            dados = json.load(f)
            pessoas = dados.get("pacientes", []) if isinstance(dados, dict) else dados
            pessoas_validas = []
            
            mapa_prioridades = {
                "urgente": "URGENTE",
                "emergência": "URGENTE",
                "emergencia": "URGENTE",
                "alta": "ALTA",
                "normal": "NORMAL",
                "baixa": "BAIXA"
            }
            
            for p in pessoas:
                if isinstance(p, dict):
                    if "prioridade" not in p:
                        p["prioridade"] = "NORMAL"
                    else:
                        prioridade_lower = str(p["prioridade"]).lower().strip()
                        p["prioridade"] = mapa_prioridades.get(prioridade_lower, "NORMAL")
                    
                    if "doenca" not in p:
                        p["doenca"] = "Check-up"
                    
                    if "nome" not in p:
                        p["nome"] = "Paciente Desconhecido"
                    
                    if "idade" not in p:
                        p["idade"] = "N/A"
                    
                    if "sexo" not in p:
                        p["sexo"] = "N/A"
                    
                    if "telefone" not in p:
                        p["telefone"] = "N/A"
                    
                    pessoas_validas.append(p)
            return pessoas_validas
    except:
        return []

