def mostrar_grafico_fila_vs_taxa_resultados(resultados):
    """Mostra gráfico com resultados da análise fila vs taxa"""
    if not resultados:
        sg.popup_error("Nenhum resultado disponível para análise.", title="Erro")
        return
    
    taxas = [r["taxa"] for r in resultados]
    tamanhos_fila = [r["tamanho_medio_fila"] for r in resultados]
    tempos_espera = [r["tempo_medio_espera"] for r in resultados]
    atendidos = [r["atendidos"] for r in resultados]
    desistentes = [r["desistentes"] for r in resultados]
    
    fig = Figure(figsize=(12, 10), dpi=80)
    
    ax1 = fig.add_subplot(221)
    ax1.plot(taxas, tamanhos_fila, 'b-o', linewidth=2, markersize=8)
    ax1.set_xlabel('Taxa de Chegada (pacientes/hora)')
    ax1.set_ylabel('Tamanho Médio da Fila')
    ax1.set_title('Tamanho Médio da Fila vs Taxa de Chegada')
    ax1.grid(True, alpha=0.3)
    
    for i in range(len(taxas)):
        if tamanhos_fila[i] > 10:
            ax1.plot(taxas[i], tamanhos_fila[i], 'ro', markersize=10)
            ax1.annotate(f'Crítico: {tamanhos_fila[i]:.1f}', 
                        xy=(taxas[i], tamanhos_fila[i]),
                        xytext=(5, 5), textcoords='offset points',
                        color='red', fontweight='bold')
    
    ax2 = fig.add_subplot(222)
    ax2.plot(taxas, tempos_espera, 'r-s', linewidth=2, markersize=8)
    ax2.set_xlabel('Taxa de Chegada (pacientes/hora)')
    ax2.set_ylabel('Tempo Médio de Espera (min)')
    ax2.set_title('Tempo de Espera vs Taxa de Chegada')
    ax2.grid(True, alpha=0.3)
    
    ax2.axhline(y=30, color='orange', linestyle='--', alpha=0.7, label='Limite 30 min')
    ax2.legend()
    
    ax3 = fig.add_subplot(223)
    ax3.plot(taxas, atendidos, 'g-^', linewidth=2, markersize=8, label='Atendidos')
    ax3.plot(taxas, desistentes, 'r-v', linewidth=2, markersize=8, label='Desistentes')
    ax3.set_xlabel('Taxa de Chegada (pacientes/hora)')
    ax3.set_ylabel('Número de Pacientes')
    ax3.set_title('Atendidos e Desistentes vs Taxa de Chegada')
    ax3.grid(True, alpha=0.3)
    ax3.legend()
    
    ax4 = fig.add_subplot(224)
    
    num_medicos = estado_simulacao.get("num_medicos", len(estado_simulacao.get("medicos", [])) or NUM_MEDICOS)
    tempo_simulacao_horas = 4
    
    produtividades = []
    for atendido in atendidos:
        prod = atendido / (num_medicos * tempo_simulacao_horas) if num_medicos > 0 else 0
        produtividades.append(prod)
    
    ax4.plot(taxas, produtividades, 'm-*', linewidth=2, markersize=10)
    ax4.set_xlabel('Taxa de Chegada (pacientes/hora)')
    ax4.set_ylabel('Pacientes/Médico/Hora')
    ax4.set_title('Produtividade vs Taxa de Chegada')
    ax4.grid(True, alpha=0.3)
    
    ax4.axhline(y=1.5, color='green', linestyle='--', alpha=0.7, label='Ideal: 1.5')
    ax4.legend()
    
    fig.tight_layout()
    
    relatorio = []
    relatorio.append("ANÁLISE: FILA VS TAXA DE CHEGADA")
    relatorio.append("=" * 60)
    relatorio.append(f"Data/Hora: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}")
    relatorio.append(f"Número de médicos: {num_medicos}")
    relatorio.append(f"Tempo por simulação: 240 minutos (4 horas)")
    relatorio.append("")
    relatorio.append("RESULTADOS:")
    relatorio.append("-" * 60)
    
    for r in resultados:
        relatorio.append(f"Taxa {r['taxa']} pacientes/hora:")
        relatorio.append(f"  • Tamanho médio da fila: {r['tamanho_medio_fila']:.1f} pacientes")
        relatorio.append(f"  • Tempo médio de espera: {r['tempo_medio_espera']:.1f} minutos")
        relatorio.append(f"  • Pacientes atendidos: {r['atendidos']}")
        relatorio.append(f"  • Pacientes desistentes: {r['desistentes']}")
        relatorio.append("")
    
    relatorio.append("CONCLUSÕES:")
    relatorio.append("-" * 60)
    
    ponto_saturacao = None
    for i in range(len(taxas) - 1):
        if tamanhos_fila[i+1] > tamanhos_fila[i] * 1.5:
            ponto_saturacao = taxas[i]
    
    if ponto_saturacao:
        relatorio.append(f"• Ponto de saturação estimado: {ponto_saturacao} pacientes/hora")
        relatorio.append(f"  Acima desta taxa, o sistema começa a ficar sobrecarregado")
    else:
        relatorio.append("• Sistema estável em todas as taxas testadas")
    
    taxa_ideal = None
    for i in range(len(taxas)):
        if tempos_espera[i] <= 30:
            taxa_ideal = taxas[i]
    
    if taxa_ideal:
        relatorio.append(f"• Taxa ideal (espera ≤ 30min): {taxa_ideal} pacientes/hora")
    else:
        relatorio.append("• Nenhuma taxa mantém espera abaixo de 30 minutos")
    
    texto_relatorio = "\n".join(relatorio)
    
    tab1_layout = [
        [sg.Canvas(key="-CANVAS_FILA_TAXA-", size=(800, 600))]
    ]
    
    tab2_layout = [
        [sg.Multiline(texto_relatorio, size=(100, 35), key="-RELATORIO_ANALISE-", 
                     font=("Courier New", 9), disabled=True, horizontal_scroll=True, autoscroll=True)]
    ]
    
    layout = [
        [sg.Text("Resultados: Fila vs Taxa de Chegada", font=("Helvetica", 16), justification="center", expand_x=True)],
        [sg.TabGroup([
            [sg.Tab('Gráficos', tab1_layout)],
            [sg.Tab('Relatório', tab2_layout)]
        ], key="-TABS_ANALISE-", expand_x=True, expand_y=True)],
        [
            sg.Button("Exportar Relatório", size=(18,1), button_color=('white',escuro)),
            sg.Button("Salvar Gráfico", size=(15,1), button_color=('white',escuro)),
            sg.Button("Fechar", size=(12,1), button_color=('white',escuro))
        ]
    ]
    
    window = sg.Window("Resultados da Análise", layout, modal=True, finalize=True, size=(850, 700), 
                      resizable=True, keep_on_top=True)
    
    canvas = fig_tk.FigureCanvasTkAgg(fig, window["-CANVAS_FILA_TAXA-"].TKCanvas)
    canvas.draw()
    canvas.get_tk_widget().pack(side='top', fill='both', expand=1)
    
    continuar = True
    while continuar:
        event, values = window.read()
        
        if event in (sg.WINDOW_CLOSED, "Fechar"):
            continuar = False
        
        elif event == "Exportar Relatório":
            nome_arquivo = f"analise_fila_taxa_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
            arquivo_salvo = salvar_arquivo(texto_relatorio, nome_arquivo)
            if arquivo_salvo:
                sg.popup(f"Relatório exportado para:\n{arquivo_salvo}", title="Sucesso")
            else:
