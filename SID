import random
import math

# Constantes
CHEGADA = 0
SAIDA = 1

def simula(parametros, medicos_data, pacientes_data):
    """Versão corrigida - tempo de consulta correto"""
    
    # Configurar semente aleatória
    if "seed" in parametros:
        random.seed(parametros["seed"])
    
    lamb = parametros["lambda"]
    duracao_turno = parametros["simtime"]
    
    # Preparar estrutura de médicos
    medicos = []
    i = 0
    while i < len(medicos_data):
        # [dados, ocupado?, paciente_atual, tempo_inicio_atual, tempo_total_ocupado, atendimentos, duracao_planejada]
        linha = [medicos_data[i], False, None, 0.0, 0.0, 0, 0.0]
        medicos.append(linha)
        i = i + 1
    
    # Inicializar estruturas
    eventos = []
    fila = []
    
    # Inicializar estatísticas
    estatisticas = {
        "atendidos": 0,
        "tempos_espera": [],
        "tempos_atendimento": [],  # Aqui vamos guardar o tempo REAL de cada consulta
        "ocupacao_medicos": [0.0] * len(medicos),
        "atendimentos_por_medico": [0] * len(medicos)
    }
    
    # Registrar tempos de chegada
    chegadas = {}
    
    # Gerar eventos iniciais de chegada
    tempo_atual = 0.0
    idx_paciente = 0
    
    # Agendar pausas (2 pausas de 15 minutos = 0.25 horas cada)
    horarios_pausa = []
    i = 0
    while i < len(medicos):
        # Primeira pausa (2h - 2.25h)
        if 2.0 < duracao_turno:
            horarios_pausa.append((2.0, 2.25, i))
        
        # Segunda pausa (4h - 4.25h)
        if 4.0 < duracao_turno:
            horarios_pausa.append((4.0, 4.25, i))
        
        i = i + 1
    
    # Gerar chegadas de pacientes
    while tempo_atual < duracao_turno and idx_paciente < len(pacientes_data):
        paciente = pacientes_data[idx_paciente]
        chegadas[paciente["id"]] = tempo_atual
        
        # Criar evento de chegada
        evento = (tempo_atual, CHEGADA, paciente["id"])
        eventos = enqueue(eventos, evento)
        
        # Gerar próxima chegada
        intervalo = genTempoChegada(lamb)
        tempo_atual = tempo_atual + intervalo
        idx_paciente = idx_paciente + 1
    
    # Executar loop de eventos
    tempo_simulacao = 0.0
    
    while eventos != []:
        # Pegar próximo evento
        ev, eventos = dequeue(eventos)
        tempo_evento, tipo_evento, paciente_id = ev
        
        tempo_simulacao = tempo_evento
        
        # Encontrar paciente
        paciente = None
        i = 0
        while i < len(pacientes_data) and paciente is None:
            if pacientes_data[i]["id"] == paciente_id:
                paciente = pacientes_data[i]
            i = i + 1
        
        if paciente is None:
            continue
        
        # ------------------------------------
        # EVENTO DE CHEGADA
        # ------------------------------------
        if tipo_evento == CHEGADA:
            # Verificar se médico está disponível
            medico_disponivel = None
            medico_idx = -1
            
            i = 0
            while i < len(medicos):
                if not medicos[i][1]:  # não ocupado
                    # Verificar se não está em pausa
                    em_pausa = False
                    j = 0
                    while j < len(horarios_pausa):
                        inicio_pausa, fim_pausa, idx_medico_pausa = horarios_pausa[j]
                        if idx_medico_pausa == i and tempo_evento >= inicio_pausa and tempo_evento < fim_pausa:
                            em_pausa = True
                        j = j + 1
                    
                    if not em_pausa:
                        medico_disponivel = medicos[i]
                        medico_idx = i
                        i = len(medicos)  # sair do loop
                i = i + 1
            
            if medico_disponivel is not None:
                # Atender imediatamente
                medico_disponivel[1] = True
                medico_disponivel[2] = paciente_id
                medico_disponivel[3] = tempo_evento
                medico_disponivel[5] = medico_disponivel[5] + 1
                
                # Calcular DURAÇÃO PLANEJADA da consulta
                duracao_planejada = genTempoConsulta(medico_disponivel[0], paciente)
                medico_disponivel[6] = duracao_planejada  # guardar duração planejada
                
                # Calcular quando terminará a consulta
                tempo_fim_planejado = tempo_evento + duracao_planejada
                
                # Verificar se há pausa durante esta consulta
                j = 0
                while j < len(horarios_pausa):
                    inicio_pausa, fim_pausa, idx_medico = horarios_pausa[j]
                    if idx_medico == medico_idx:
                        # Se a consulta cruza com a pausa
                        if tempo_evento < fim_pausa and tempo_fim_planejado > inicio_pausa:
                            # Ajustar para depois da pausa
                            tempo_fim_planejado = fim_pausa + (duracao_planejada - (inicio_pausa - tempo_evento))
                    j = j + 1
                
                # Se termina depois do turno, ajustar
                if tempo_fim_planejado > duracao_turno:
                    tempo_fim_planejado = duracao_turno
                
                # Agendar saída
                if tempo_fim_planejado <= duracao_turno:
                    novo_evento = (tempo_fim_planejado, SAIDA, paciente_id)
                    eventos = enqueue(eventos, novo_evento)
                
                # Tempo de espera
                tempo_espera = tempo_evento - chegadas[paciente_id]
                estatisticas["tempos_espera"].append(tempo_espera)
                
            else:
                # Colocar na fila
                fila.append(paciente)
                fila = ordenarFila(fila)
        
        # ------------------------------------
        # EVENTO DE SAÍDA
        # ------------------------------------
        elif tipo_evento == SAIDA:
            estatisticas["atendidos"] = estatisticas["atendidos"] + 1
            
            # Encontrar médico que atendeu
            i = 0
            while i < len(medicos):
                if medicos[i][2] == paciente_id:
                    # Calcular tempo REAL da consulta
                    tempo_inicio = medicos[i][3]
                    duracao_real = tempo_evento - tempo_inicio
                    
                    # Adicionar tempo REAL à lista
                    estatisticas["tempos_atendimento"].append(duracao_real)
                    
                    # Adicionar ao tempo ocupado total do médico
                    medicos[i][4] = medicos[i][4] + duracao_real
                    
                    # Liberar médico
                    medicos[i][1] = False
                    medicos[i][2] = None
                    medicos[i][3] = 0.0
                    medicos[i][6] = 0.0
                    
                    # Tentar atender próximo da fila
                    if fila != [] and tempo_evento < duracao_turno:
                        prox_paciente = fila[0]
                        fila = fila[1:]
                        
                        # Verificar se médico está em pausa agora
                        em_pausa = False
                        j = 0
                        while j < len(horarios_pausa):
                            inicio_pausa, fim_pausa, idx_medico = horarios_pausa[j]
                            if idx_medico == i and tempo_evento >= inicio_pausa and tempo_evento < fim_pausa:
                                em_pausa = True
                            j = j + 1
                        
                        if not em_pausa:
                            # Atender próximo
                            medicos[i][1] = True
                            medicos[i][2] = prox_paciente["id"]
                            medicos[i][3] = tempo_evento
                            medicos[i][5] = medicos[i][5] + 1
                            
                            # Calcular duração planejada
                            duracao_planejada = genTempoConsulta(medicos[i][0], prox_paciente)
                            medicos[i][6] = duracao_planejada
                            
                            # Calcular tempo de término
                            tempo_fim_planejado = tempo_evento + duracao_planejada
                            
                            # Verificar pausas
                            j = 0
                            while j < len(horarios_pausa):
                                inicio_pausa, fim_pausa, idx_medico = horarios_pausa[j]
                                if idx_medico == i:
                                    if tempo_evento < fim_pausa and tempo_fim_planejado > inicio_pausa:
                                        tempo_fim_planejado = fim_pausa + (duracao_planejada - (inicio_pausa - tempo_evento))
                                j = j + 1
                            
                            if tempo_fim_planejado > duracao_turno:
                                tempo_fim_planejado = duracao_turno
                            
                            if tempo_fim_planejado <= duracao_turno:
                                novo_evento = (tempo_fim_planejado, SAIDA, prox_paciente["id"])
                                eventos = enqueue(eventos, novo_evento)
                            
                            tempo_espera = tempo_evento - chegadas[prox_paciente["id"]]
                            estatisticas["tempos_espera"].append(tempo_espera)
                    
                    i = len(medicos)  # sair do loop
                i = i + 1
    
    # Calcular estatísticas finais
    i = 0
    while i < len(medicos):
        # Tempo total disponível (descontando pausas)
        tempo_total_disponivel = duracao_turno - 0.5  # 30 minutos de pausas
        
        if tempo_total_disponivel > 0:
            ocupacao = (medicos[i][4] / tempo_total_disponivel) * 100
        else:
            ocupacao = 0
        
        # Garantir máximo 100%
        if ocupacao > 100:
            ocupacao = 100
        
        estatisticas["ocupacao_medicos"][i] = ocupacao
        estatisticas["atendimentos_por_medico"][i] = medicos[i][5]
        i = i + 1
    
    # Calcular médias CORRETAMENTE
    if estatisticas["atendidos"] > 0:
        # Média de espera
        soma_espera = 0
        i = 0
        while i < len(estatisticas["tempos_espera"]):
            soma_espera = soma_espera + estatisticas["tempos_espera"][i]
            i = i + 1
        estatisticas["espera_media"] = soma_espera / estatisticas["atendidos"]
        
        # Média de atendimento (tempo REAL)
        soma_atendimento = 0
        i = 0
        while i < len(estatisticas["tempos_atendimento"]):
            soma_atendimento = soma_atendimento + estatisticas["tempos_atendimento"][i]
            i = i + 1
        estatisticas["atendimento_medio"] = soma_atendimento / estatisticas["atendidos"]
    else:
        estatisticas["espera_media"] = 0
        estatisticas["atendimento_medio"] = 0
    
    return estatisticas


