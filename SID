        # 4. Score geral
        ax4 = fig.add_subplot(224)
        bars4 = ax4.bar(range(len(nomes)), scores, color='gold', edgecolor='black')
        ax4.set_xticks(range(len(nomes)))
        ax4.set_xticklabels(nomes, rotation=45, ha='right')
        ax4.set_ylabel('Score (0-100)')
        ax4.set_title('Score Geral de Desempenho')
        ax4.set_ylim(0, 100)
        ax4.grid(True, alpha=0.3, axis='y')
        
        if scores:
            idx_melhor = scores.index(max(scores))
            bars4[idx_melhor].set_color('green')
        
        fig.suptitle(f'Comparação de Desempenho - {especialidade_filtro}', fontsize=14)
        fig.tight_layout(rect=[0, 0, 1, 0.96])
        
        return fig
    
    def criar_analise_detalhada(medico_idx):
