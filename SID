    if not metricas:
        sg.popup_error("Nenhum dado para exportar!", title="Erro")
        return
    
    timestamp = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
    tempo_atual = estado_simulacao.get("tempo_atual", 480)
    
    relatorio = []
    relatorio.append("RELATÓRIO COMPLETO DE DESEMPENHO MÉDICO")
    relatorio.append("=" * 80)
    relatorio.append(f"Data/Hora: {timestamp}")
    relatorio.append(f"Tempo da simulação: {tempo_atual:.0f} minutos")
    relatorio.append(f"Total de médicos analisados: {len(metricas)}")
    relatorio.append("")
    
    # Resumo geral
    relatorio.append("RESUMO GERAL:")
    relatorio.append("-" * 80)
    
    # Calcular médias gerais
    if metricas:
        media_eficiencia = np.mean([m["eficiencia"] for m in metricas])
        media_ocupacao = np.mean([m["taxa_ocupacao"] for m in metricas])
        media_tempo = np.mean([m["tempo_medio_consulta"] for m in metricas])
        media_corresp = np.mean([m["taxa_correspondencia"] for m in metricas])
        media_score = np.mean([m["score_desempenho"] for m in metricas])
        total_atendimentos = sum([m["num_atendimentos"] for m in metricas])
        
        relatorio.append(f"• Total de atendimentos: {total_atendimentos}")
        relatorio.append(f"• Eficiência média: {media_eficiencia:.1f} pacientes/hora")
        relatorio.append(f"• Ocupação média: {media_ocupacao:.1f}%")
        relatorio.append(f"• Tempo médio de consulta: {media_tempo:.1f} minutos")
        relatorio.append(f"• Correspondência média: {media_corresp:.1f}%")
        relatorio.append(f"• Score médio: {media_score:.0f}/100")
    
    relatorio.append("")
    
    # Detalhes por médico
    for i, medico in enumerate(metricas):
        relatorio.append(f"MÉDICO {i+1}: {medico['nome']} ({medico['especialidade']})")
        relatorio.append("-" * 60)
        relatorio.append(f"Score: {medico['score_desempenho']:.0f}/100")
        relatorio.append(f"Atendimentos: {medico['num_atendimentos']}")
        relatorio.append(f"Eficiência: {medico['eficiencia']:.1f} pacientes/hora")
        relatorio.append(f"Ocupação: {medico['taxa_ocupacao']:.1f}%")
        relatorio.append(f"Tempo médio: {medico['tempo_medio_consulta']:.1f} minutos")
        relatorio.append(f"Correspondência: {medico['taxa_correspondencia']:.1f}%")
        relatorio.append(f"Horário de pico: {medico['horario_pico']}")
        
        # Distribuição por prioridade
        relatorio.append("Distribuição por prioridade:")
        for prioridade, quantidade in medico["atendimentos_por_prioridade"].items():
            if medico["num_atendimentos"] > 0:
                percentual = (quantidade / medico["num_atendimentos"]) * 100
                relatorio.append(f"  - {prioridade}: {quantidade} ({percentual:.1f}%)")
        
        relatorio.append("")
    
    # Rankings
    relatorio.append("RANKINGS:")
    relatorio.append("-" * 80)
    
    # Top 5 eficiência
    top_eficiencia = sorted(metricas, key=lambda x: x["eficiencia"], reverse=True)[:5]
    relatorio.append("Top 5 - Eficiência:")
    for i, med in enumerate(top_eficiencia):
