    def atualizar_rankings():
        # Ranking por eficiência
        eficiencia_ordenada = sorted(metricas, key=lambda x: x["eficiencia"], reverse=True)[:5]
        texto_eficiencia = ""
        for i, med in enumerate(eficiencia_ordenada):
            texto_eficiencia += f"{i+1}. {med['nome']} ({med['especialidade']})\n"
            texto_eficiencia += f"   Eficiência: {med['eficiencia']:.1f} pacientes/hora\n"
            texto_eficiencia += f"   Atendimentos: {med['num_atendimentos']}\n\n"
        
        # Ranking por correspondência
        corresp_ordenada = sorted(metricas, key=lambda x: x["taxa_correspondencia"], reverse=True)[:5]
        texto_corresp = ""
        for i, med in enumerate(corresp_ordenada):
            texto_corresp += f"{i+1}. {med['nome']} ({med['especialidade']})\n"
            texto_corresp += f"   Correspondência: {med['taxa_correspondencia']:.1f}%\n"
            texto_corresp += f"   Atendimentos: {med['num_atendimentos']}\n\n"
        
        # Ranking por tempo médio (mais rápido)
        tempo_ordenada = sorted(metricas, key=lambda x: x["tempo_medio_consulta"])[:5]
        texto_tempo = ""
        for i, med in enumerate(tempo_ordenada):
            texto_tempo += f"{i+1}. {med['nome']} ({med['especialidade']})\n"
            texto_tempo += f"   Tempo médio: {med['tempo_medio_consulta']:.1f} minutos\n"
            texto_tempo += f"   Desvio padrão: {med['desvio_consulta']:.1f} min\n\n"
        
        # Ranking por score geral
        score_ordenada = sorted(metricas, key=lambda x: x["score_desempenho"], reverse=True)[:5]
        texto_score = ""
        for i, med in enumerate(score_ordenada):
            texto_score += f"{i+1}. {med['nome']} ({med['especialidade']})\n"
            texto_score += f"   Score: {med['score_desempenho']:.0f}/100\n"
            texto_score += f"   Eficiência: {med['eficiencia']:.1f} | Corresp: {med['taxa_correspondencia']:.1f}%\n\n"
        
        window["-RANKING_EFICIENCIA-"].update(texto_eficiencia)
        window["-RANKING_CORRESP-"].update(texto_corresp)
        window["-RANKING_TEMPO-"].update(texto_tempo)
        window["-RANKING_SCORE-"].update(texto_score)
    
    def criar_grafico_comparacao(especialidade_filtro="Todas"):
        # Filtrar médicos
        if especialidade_filtro == "Todas":
            medicos_filtrados = metricas
