        if atendimentos:
            media_atend = sum(atendimentos) / len(atendimentos)
            min_atend = min(atendimentos)
            max_atend = max(atendimentos)
            layout.append([sg.Text(f"  Media: {media_atend:.2f} horas")])
            layout.append([sg.Text(f"  Minimo: {min_atend:.2f} horas")])
            layout.append([sg.Text(f"  Maximo: {max_atend:.2f} horas")])
    
    layout.append([sg.Text("")])
    layout.append([sg.Button("Fechar", size=(15,1))])
    
    sg.Window("Resultados Detalhados", layout, modal=True, size=(650, 500)).read(close=True)


def mostrarGraficos(resultados, medicos):
    try:
        # Validate input data
        if not resultados or not medicos:
            sg.popup_error("Dados insuficientes para gerar gráficos.")
            return

        fig, axs = plt.subplots(2, 2, figsize=(14, 10))
        fig.suptitle('Análise da Simulação Clínica', fontsize=16, fontweight='bold', y=0.98)

        # Graph 1: Doctor Occupancy
        if 'ocupacao_medicos' in resultados and resultados['ocupacao_medicos'] and len(resultados['ocupacao_medicos']) > 0:
            medicos_nomes = [m['nome'][:12] for m in medicos]
            ocupacoes = resultados['ocupacao_medicos']

            # Ensure data consistency
            num_items = min(len(ocupacoes), len(medicos_nomes))
            if num_items == 0:
                axs[0, 0].text(0.5, 0.5, 'Sem dados de ocupação',
                              ha='center', va='center', transform=axs[0, 0].transAxes)
                axs[0, 0].set_title('Ocupação dos Médicos (%)')
                axs[0, 0].set_xlim(0, 1)
                axs[0, 0].set_ylim(0, 1)
            else:
                medicos_nomes = medicos_nomes[:num_items]
                ocupacoes = ocupacoes[:num_items]

                cores = plt.cm.tab10(np.linspace(0, 1, num_items))
                bars = axs[0, 0].bar(medicos_nomes, ocupacoes, color=cores, alpha=0.8, edgecolor='black', linewidth=0.5)
                axs[0, 0].set_title('Ocupação dos Médicos (%)', fontsize=12, fontweight='bold')
                axs[0, 0].set_ylabel('Porcentagem (%)', fontsize=10)
                axs[0, 0].set_ylim(0, 105)
                axs[0, 0].grid(axis='y', alpha=0.3, linestyle='--')
                axs[0, 0].tick_params(axis='x', rotation=45)

                for bar in bars:
                    altura = bar.get_height()
                    axs[0, 0].text(bar.get_x() + bar.get_width()/2., altura + 1,
                                  f'{altura:.1f}%', ha='center', va='bottom', fontsize=9, fontweight='bold')
        else:
            axs[0, 0].text(0.5, 0.5, 'Dados não disponíveis',
                          ha='center', va='center', transform=axs[0, 0].transAxes, fontsize=12)
            axs[0, 0].set_title('Ocupação dos Médicos (%)', fontsize=12)
        
        if 'tempos_espera' in resultados and resultados['tempos_espera']:
            tempos = resultados['tempos_espera']
            axs[0, 1].hist(tempos, bins=15, color='skyblue', edgecolor='black', alpha=0.7)
            axs[0, 1].set_title('Distribuicao de Tempos de Espera')
            axs[0, 1].set_xlabel('Tempo (horas)')
            axs[0, 1].set_ylabel('Frequencia')
            
            if tempos:
                media = sum(tempos) / len(tempos)
                axs[0, 1].axvline(media, color='red', linestyle='--', 
                                label=f'Media: {media:.2f}h')
                axs[0, 1].legend()
            axs[0, 1].grid(alpha=0.3)
        
        # Graph 3: Service Time Distribution
        if 'tempos_atendimento' in resultados and resultados['tempos_atendimento'] and len(resultados['tempos_atendimento']) > 0:
            tempos = [t for t in resultados['tempos_atendimento'] if t > 0]  # Filter out invalid values

            if len(tempos) == 0:
                axs[1, 0].text(0.5, 0.5, 'Sem dados de atendimento válidos',
                              ha='center', va='center', transform=axs[1, 0].transAxes)
                axs[1, 0].set_title('Distribuição de Tempos de Atendimento')
            else:
                n_bins = min(20, len(tempos)) if len(tempos) > 5 else max(5, len(tempos))
                axs[1, 0].hist(tempos, bins=n_bins, color='lightgreen', edgecolor='darkgreen', alpha=0.8, linewidth=0.5)
                axs[1, 0].set_title('Distribuição de Tempos de Atendimento', fontsize=12, fontweight='bold')
                axs[1, 0].set_xlabel('Tempo (horas)', fontsize=10)
                axs[1, 0].set_ylabel('Frequência', fontsize=10)

                media = sum(tempos) / len(tempos)
                axs[1, 0].axvline(media, color='darkgreen', linestyle='--', linewidth=2,
                                label=f'Média: {media:.3f}h')
                axs[1, 0].legend(fontsize=9)
                axs[1, 0].grid(alpha=0.3, linestyle='--')
        else:
            axs[1, 0].text(0.5, 0.5, 'Dados não disponíveis',
                          ha='center', va='center', transform=axs[1, 0].transAxes, fontsize=12)
            axs[1, 0].set_title('Distribuição de Tempos de Atendimento', fontsize=12)
        
        if 'atendimentos_por_medico' in resultados and resultados['atendimentos_por_medico']:
            atendimentos = resultados['atendimentos_por_medico']
            medicos_nomes = [m['nome'][:15] for m in medicos]
            
            num_graficos = min(len(atendimentos), len(medicos_nomes))
            medicos_nomes = medicos_nomes[:num_graficos]
            atendimentos = atendimentos[:num_graficos]
            
            cores = plt.cm.Pastel1(np.linspace(0, 1, len(medicos_nomes)))
            bars = axs[1, 1].bar(medicos_nomes, atendimentos, color=cores)
            axs[1, 1].set_title('Atendimentos por Medico')
            axs[1, 1].set_ylabel('Numero de Atendimentos')
            axs[1, 1].grid(axis='y', alpha=0.3)
            
            k = 0
            for bar in bars:
                altura = bar.get_height()
                axs[1, 1].text(bar.get_x() + bar.get_width()/2., altura + 0.1,
                              f'{int(altura)}', ha='center', va='bottom', fontsize=8)
                k = k + 1
        
        # Ensure all subplots have proper formatting even if empty
        for i in range(2):
            for j in range(2):
                if not axs[i, j].has_data():
                    axs[i, j].text(0.5, 0.5, 'Dados não disponíveis',
                                  ha='center', va='center', transform=axs[i, j].transAxes,
                                  fontsize=12, color='gray', style='italic')
                    axs[i, j].set_frame_on(False)
                    axs[i, j].set_xticks([])
                    axs[i, j].set_yticks([])
        
        criarJanelaGraficos(fig)
        
    except Exception as e:
        sg.popup_error(f"Erro ao criar graficos: {str(e)}")


def criarJanelaGraficos(fig):
    def draw_figure(canvas, figure):
        figure_canvas_agg = FigureCanvasTkAgg(figure, canvas)
        figure_canvas_agg.draw()
        figure_canvas_agg.get_tk_widget().pack(side='top', fill='both', expand=1)
        return figure_canvas_agg
    
    layout = [
        [sg.Text("Graficos da Simulacao", font=('Arial', 16))],
        [sg.Canvas(key='-CANVAS-', size=(800, 600))],
        [sg.Button("Salvar Imagem", key='-SAVE-', size=(15,1)), 
         sg.Button("Fechar", key='-CLOSE-', size=(15,1))]
    ]
    
    window = sg.Window("Graficos", layout, finalize=True, element_justification='center')
    
    canvas_elem = window['-CANVAS-']
    canvas = canvas_elem.TKCanvas
    figure_canvas_agg = draw_figure(canvas, fig)
    
    fechar_janela = False
    while not fechar_janela:
        event, values = window.read()
        
        if event == sg.WIN_CLOSED or event == '-CLOSE-':
            fechar_janela = True
        elif event == '-SAVE-':
            filename = sg.popup_get_file('Salvar grafico como', 
                                        save_as=True, 
                                        default_extension='.png',
                                        file_types=(("PNG files", "*.png"), 
                                                   ("JPEG files", "*.jpg"),
                                                   ("PDF files", "*.pdf"),
                                                   ("All files", "*.*")))
            if filename:
                try:
                    fig.savefig(filename, dpi=300, bbox_inches='tight')
                    sg.popup("Sucesso", f"Grafico salvo em:\n{filename}")
                except Exception as e:
                    sg.popup_error(f"Erro ao salvar:\n{str(e)}")
    
    window.close()
    plt.close(fig)


