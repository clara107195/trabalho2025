    if tem_dados_atuais:
        opcoes.append("Simulação Atual")
    
    if tem_simulacoes_antigas:
        for sim in estado_simulacao["resultados_simulacoes"]:
            config = sim["configuracao"]
            timestamp = sim["timestamp"]
            data_formatada = datetime.strptime(timestamp, "%Y-%m-%d %H:%M:%S").strftime("%d/%m/%Y %H:%M:%S")
            texto = f"λ={config['lambda_chegada']} M={config['num_medicos']} {data_formatada}"
