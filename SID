                    {"id": "m2", "nome": "Dra. Maria Santos", "especialidade": "Clínica Geral"}
                ]
            return medicos
    except:
        return [
            {"id": "m1", "nome": "Dr. António Silva", "especialidade": "Clínica Geral"},
            {"id": "m2", "nome": "Dra. Maria Santos", "especialidade": "Clínica Geral"}
        ]

def ordenar_fila_por_prioridade(fila):
    return sorted(fila, key=lambda x: (PRIORIDADES.get(x["prioridade"], 3), x["tempo_chegada"]))

def gera_tempo_consulta(tempo_medio=TEMPO_MEDIO_CONSULTA, dist=DISTRIBUICAO_TEMPO_CONSULTA):
    if dist == "exponential":
        tempo = np.random.exponential(tempo_medio)
    elif dist == "normal":
        tempo = np.random.normal(tempo_medio, 5)
    elif dist == "uniform":
        tempo = np.random.uniform(tempo_medio * 0.5, tempo_medio * 1.5)
    else:
        tempo = tempo_medio
    
    tempo = max(tempo_medio * 0.3, min(tempo, tempo_medio * 2.0))
    return tempo

def login_admin(email, password):
    try:
        with open("usersadmin.json", "r", encoding="utf-8") as f:
            usuarios = json.load(f)
    except:
        usuarios = [{"email": "admin@clinica.com", "password": "admin123"}]
    
    for user in usuarios:
        if user['email'] == email and user['password'] == password:
            return True
    return False

