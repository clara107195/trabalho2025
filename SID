def enqueue(lista, elem):
    """Adiciona elemento à lista mantendo ordenação por tempo"""
    lista.append(elem)
    # Ordena pelo primeiro elemento (tempo)
    lista.sort(key=lambda x: x[0])
    return lista

def dequeue(lista):
    """Remove e retorna o primeiro elemento da lista"""
    if len(lista) == 0:
        return None, []
    elem = lista[0]
    nova = lista[1:]
    return elem, nova

def genTempoChegada(lamb):
    """Gera tempo entre chegadas (distribuição exponencial)"""
    r = random.random()
    # Evitar log(0)
    if r == 0:
        r = 0.000001
    return -math.log(1 - r) / lamb

def genTempoConsulta(medico, paciente):
    """Gera tempo de consulta baseado no médico e paciente"""
    r = random.random()
    # Evitar log(0)
    if r == 0:
        r = 0.000001
    
    # Tempo base da distribuição exponencial
    tempo_base = -math.log(1 - r) * medico["media_consulta"]
    
    # Aumenta tempo conforme número de doenças
    num_doencas = len(paciente.get("doencas", []))
    fator_doencas = 1 + (0.15 * num_doencas)
    
    tempo_final = tempo_base * fator_doencas
    
    return tempo_final

def procuraMedico(medicos):
    """Procura médico livre - mantida para compatibilidade"""
    i = 0
    res = None
    while i < len(medicos):
        if medicos[i][1] == False:
            res = medicos[i]
            i = len(medicos)  # sair do loop
        i = i + 1
    return res

def ordenarFila(fila):
    """Ordena fila por prioridade (1 é mais urgente)"""
    fila.sort(key=lambda x: x["prioridade"])
    return fila


