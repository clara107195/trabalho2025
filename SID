                labels_boxplot.append(prioridade)
        
        if dados_boxplot:
            bp = ax4.boxplot(dados_boxplot, labels=labels_boxplot, patch_artist=True)
            # Cores diferentes para cada caixa
            colors_box = ['lightcoral', 'lightyellow', 'lightblue', 'lightgreen']
            for patch, color in zip(bp['boxes'], colors_box[:len(dados_boxplot)]):
                patch.set_facecolor(color)
            
            ax4.set_ylabel('Tempo de Espera (min)')
            ax4.set_title('Tempo de Espera por Prioridade')
            ax4.grid(True, alpha=0.3, axis='y')
        else:
            ax4.text(0.5, 0.5, 'Sem dados\nde tempo de espera', 
                    ha='center', va='center', fontsize=12, transform=ax4.transAxes)
            ax4.set_title('Tempo de Espera por Prioridade')
            ax4.axis('off')
        
        # 5. Comparação com média da especialidade
        ax5 = fig.add_subplot(235)
        especialidade = medico["especialidade"]
        medicos_mesma_especialidade = [m for m in metricas if m["especialidade"] == especialidade]
        
        if len(medicos_mesma_especialidade) > 1:
            # Calcular médias da especialidade
            media_eficiencia = np.mean([m["eficiencia"] for m in medicos_mesma_especialidade])
            media_corresp = np.mean([m["taxa_correspondencia"] for m in medicos_mesma_especialidade])
            media_tempo = np.mean([m["tempo_medio_consulta"] for m in medicos_mesma_especialidade])
            
            # Dados para comparação
            categorias_comp = ['Eficiência', 'Corresp.', 'Tempo Médio']
            valores_medico = [medico["eficiencia"], medico["taxa_correspondencia"], medico["tempo_medio_consulta"]]
            valores_media = [media_eficiencia, media_corresp, media_tempo]
            
            x = np.arange(len(categorias_comp))
            width = 0.35
            
            bars1 = ax5.bar(x - width/2, valores_medico, width, label='Este Médico', color='blue')
            bars2 = ax5.bar(x + width/2, valores_media, width, label=f'Média {especialidade}', color='gray')
            
            ax5.set_xticks(x)
            ax5.set_xticklabels(categorias_comp)
            ax5.set_ylabel('Valor')
            ax5.set_title(f'Comparação com Média da Especialidade')
            ax5.legend()
            ax5.grid(True, alpha=0.3, axis='y')
        else:
            ax5.text(0.5, 0.5, 'Único médico\nnesta especialidade', 
                    ha='center', va='center', fontsize=12, transform=ax5.transAxes)
