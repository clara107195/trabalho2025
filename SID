            melhor_esp = max(medicos_esp, key=lambda x: x["score_desempenho"])
            relatorio.append(f"  • Melhor desempenho: {melhor_esp['nome']} (Score: {melhor_esp['score_desempenho']:.0f})")
        
        relatorio.append("")
    
    # Recomendações gerais
    relatorio.append("RECOMENDAÇÕES GERAIS:")
    relatorio.append("-" * 80)
    
    if metricas:
        # Análise da eficiência geral
        if media_eficiencia < 1.5:
            relatorio.append("• ALERTA: Eficiência geral baixa (< 1.5 pacientes/hora)")
            relatorio.append("  Sugestão: Rever processos de atendimento ou alocação de recursos")
        
        if media_corresp < 70:
            relatorio.append("• ALERTA: Baixa correspondência de especialidades (< 70%)")
            relatorio.append("  Sugestão: Melhorar triagem ou redistribuir especialistas")
        
        if media_score > 75:
            relatorio.append("• EXCELENTE: Sistema funcionando bem (score > 75)")
            relatorio.append("  Sugestão: Manter configuração atual")
        elif media_score > 50:
            relatorio.append("• SATISFATÓRIO: Sistema funcionando adequadamente")
            relatorio.append("  Sugestão: Monitorar continuamente as métricas")
        else:
            relatorio.append("• ATENÇÃO: Desempenho abaixo do esperado")
            relatorio.append("  Sugestão: Revisar estratégias e processos")
    
    relatorio.append("")
    relatorio.append("=" * 80)
    
    texto_relatorio = "\n".join(relatorio)
    
    # Salvar arquivo
    nome_arquivo = f"relatorio_desempenho_completo_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
    arquivo_salvo = salvar_arquivo(texto_relatorio, nome_arquivo)
    
    if arquivo_salvo:
        sg.popup(f"Relatório exportado para:\n{arquivo_salvo}", title="Sucesso")
    else:
        sg.popup_error("Falha ao salvar o relatório.", title="Erro")
    
    return arquivo_salvo
def main():
