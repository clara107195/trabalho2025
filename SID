            medicos_filtrados = [m for m in metricas if m["especialidade"] == especialidade_filtro]
        
        if not medicos_filtrados:
            fig = Figure(figsize=(10, 6), dpi=80)
            ax = fig.add_subplot(111)
            ax.text(0.5, 0.5, f"Nenhum médico na especialidade:\n{especialidade_filtro}", 
                   ha='center', va='center', fontsize=14, transform=ax.transAxes)
            ax.axis('off')
            return fig
        
        # Preparar dados
        nomes = [m["nome"][:15] for m in medicos_filtrados]
        eficiencias = [m["eficiencia"] for m in medicos_filtrados]
        correspondencias = [m["taxa_correspondencia"] for m in medicos_filtrados]
