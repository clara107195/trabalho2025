def gerar_graficos():
    sg.theme('TemaClinica')
    
    tem_simulacoes_antigas = len(estado_simulacao.get("resultados_simulacoes", [])) > 0
    tem_dados_atuais = len(estado_simulacao.get("dados_historicos", [])) > 0
    
