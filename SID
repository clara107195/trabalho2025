        especialidades[especialidade].append(medico)
    
    for especialidade, medicos_esp in especialidades.items():
        relatorio.append(f"{especialidade} ({len(medicos_esp)} médicos):")
        
        if medicos_esp:
            media_eficiencia_esp = np.mean([m["eficiencia"] for m in medicos_esp])
            media_corresp_esp = np.mean([m["taxa_correspondencia"] for m in medicos_esp])
            total_atend_esp = sum([m["num_atendimentos"] for m in medicos_esp])
            
            relatorio.append(f"  • Atendimentos: {total_atend_esp}")
