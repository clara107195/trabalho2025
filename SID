# ============================================================================
# FUNÇÕES DE QUEUE (FILA) DA AULA T9
# ============================================================================

def enqueue(q, item):
    """Adiciona um item ao final da fila (FIFO)."""
    return q + [item]

def dequeue(q):
    """Remove e retorna o primeiro item da fila (FIFO)."""
    if not q:
        return None, []
    return q[0], q[1:]

def queue_empty(q):
    """Verifica se a fila está vazia."""
    return len(q) == 0

def queue_peek(q):
    """Retorna o primeiro item da fila sem removê-lo."""
    if queue_empty(q):
        return None
    return q[0]

# ============================================================================
# FUNÇÕES PARA MANIPULAR A FILA DE ESPERA (usando as funções acima)
# ============================================================================

def adicionar_a_fila(fila, paciente):
    """Adiciona um paciente à fila de espera usando enqueue."""
    return enqueue(fila, paciente)

def remover_da_fila(fila):
    """Remove um paciente da fila de espera usando dequeue."""
    if queue_empty(fila):
        return None, fila
    return dequeue(fila)

def obter_proximo_paciente_fila(fila):
    """Obtém o próximo paciente da fila sem removê-lo."""
    return queue_peek(fila)

def tamanho_fila(fila):
    """Retorna o tamanho atual da fila."""
    return len(fila)

