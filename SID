                   sg.Button("Fechar", size=(12,1), button_color=('white',escuro))])
    
    window = sg.Window("Escolha de Simulação para Análise", layout, modal=True, finalize=True, keep_on_top=True)
    
    continuar = True
    while continuar:
        event, values = window.read()
        
        if event in (sg.WINDOW_CLOSED, "Fechar"):
            continuar = False
        
        elif event == "Gerar Gráficos":
            if values["-ESCOLHA_SIMULACAO-"]:
                escolha = values["-ESCOLHA_SIMULACAO-"][0]
                
