def mostraMedicos(m):
    data = []
    for medico in m:
        tempo_consulta = medico['media_consulta']
        minutos = int(tempo_consulta * 60)
        data.append([
            medico["id"],
            medico["nome"],
            medico["especialidade"],
            f"{minutos} min"
        ])
    
    layout = [
        [sg.Text(f"Lista de Medicos ({len(m)} registros)", font=('Arial', 14))],
        [sg.Table(
            data,
            headings=["ID", "Nome", "Especialidade", "Tempo Medio"],
            auto_size_columns=False,
            col_widths=[5, 25, 15, 15],
            justification='left',
            num_rows=min(20, len(data))
        )],
        [sg.Button("Fechar")]
    ]
    
    sg.Window("Medicos", layout, modal=True, size=(700, 400)).read(close=True)


def mostraPacientes(p):
    data = []
    for paciente in p:
        doencas_texto = ", ".join(paciente["doencas"]) if paciente["doencas"] else "Nenhuma"
        data.append([
            paciente["id"],
            paciente["nome"],
            paciente["idade"],
            paciente["sexo"],
            paciente["prioridade"],
            doencas_texto
        ])
    
    layout = [
        [sg.Text(f"Lista de Pacientes ({len(p)} registros)", font=('Arial', 14))],
        [sg.Table(
            data,
            headings=["ID", "Nome", "Idade", "Sexo", "Prior.", "Doencas"],
