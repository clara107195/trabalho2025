        dados = json.load(f)
        pessoas = dados.get("pacientes", []) if isinstance(dados, dict) else dados
        pessoas_validas = []
        
        mapa_prioridades = {
            "emergência": "URGENTE",
            "emergencia": "URGENTE",
            "alta": "ALTA",
            "normal": "NORMAL",
            "baixa": "BAIXA"
        }
        mapeamento_doencas = carregar_mapeamento_doencas()
        
        for p in pessoas:
            if isinstance(p, dict):
                if "prioridade" not in p:
                    p["prioridade"] = "NORMAL"
                else:
                    prioridade_lower = p["prioridade"].lower()
                    p["prioridade"] = mapa_prioridades.get(prioridade_lower, p["prioridade"].upper())
                
                if "doenca" not in p:
                    p["doenca"] = "Consulta de rotina"
                
                if "consulta_marcada" not in p:
                    p["consulta_marcada"] = False
                
                doenca_lower = p["doenca"].lower()
                especialidade_necessaria = "Clínica Geral"
                
                if doenca_lower in mapeamento_doencas:
                    especialidade_necessaria = mapeamento_doencas[doenca_lower]
                else:
                    encontrou = False
                    i = 0
                    palavras_doenca = doenca_lower.split()
                    
                    while i < len(palavras_doenca) and not encontrou:
                        palavra = palavras_doenca[i]
                        if palavra in mapeamento_doencas:
                            especialidade_necessaria = mapeamento_doencas[palavra]
                            encontrou = True
                        i = i + 1
                
                p["especialidade_necessaria"] = especialidade_necessaria
                
                pessoas_validas.append(p)
        return pessoas_validas

