def calcular_desempenho_medicos():
    """Calcula todas as métricas de desempenho para todos os médicos"""
    
    medicos = estado_simulacao.get("medicos", [])
    historico_atendimentos = estado_simulacao.get("historico_atendimentos", [])
    tempo_atual = estado_simulacao.get("tempo_atual", 480)
    pessoas_dados = estado_simulacao.get("pessoas_dados", {})
    
    if not medicos:
        return None
    
    # Estrutura para armazenar métricas detalhadas
    metricas_medicos = []
    
    for medico in medicos:
        medico_id = medico.get("id")
        medico_nome = medico.get("nome", "Desconhecido")
        medico_especialidade = medico.get("especialidade", "Geral")
        
        # Coletar todos os atendimentos deste médico
        atendimentos_medico = []
        for atendimento in historico_atendimentos:
            if atendimento.get("medico") == medico_id:
                atendimentos_medico.append(atendimento)
        
        num_atendimentos = len(atendimentos_medico)
        tempo_total_ocupado = medico.get("tempo_total_ocupado", 0)
        
        # 1. Eficiência (pacientes/hora)
        if tempo_total_ocupado > 0:
            eficiencia = num_atendimentos / (tempo_total_ocupado / 60)
        else:
            eficiencia = 0
        
        # 2. Taxa de ocupação
        taxa_ocupacao = (tempo_total_ocupado / tempo_atual * 100) if tempo_atual > 0 else 0
        
        # 3. Tempo médio de consulta
        if num_atendimentos > 0:
            duracoes = [a.get("duracao", 15) for a in atendimentos_medico]
            tempo_medio_consulta = np.mean(duracoes)
            desvio_consulta = np.std(duracoes) if len(duracoes) > 1 else 0
        else:
            tempo_medio_consulta = 0
            desvio_consulta = 0
        
        # 4. Taxa de correspondência de especialidade
        correspondencias = []
        for atendimento in atendimentos_medico:
            paciente_id = atendimento.get("paciente")
            paciente_info = pessoas_dados.get(paciente_id, {})
            especialidade_necessaria = paciente_info.get("especialidade_necessaria", "Clínica Geral")
            especialidade_correta = (medico_especialidade == especialidade_necessaria)
            correspondencias.append(especialidade_correta)
        
        if atendimentos_medico:
            taxa_correspondencia = (sum(correspondencias) / len(atendimentos_medico)) * 100
        else:
            taxa_correspondencia = 0
        
        # 5. Análise por prioridade
        atendimentos_por_prioridade = {"URGENTE": 0, "ALTA": 0, "NORMAL": 0, "BAIXA": 0}
        tempos_espera_por_prioridade = {"URGENTE": [], "ALTA": [], "NORMAL": [], "BAIXA": []}
        
        for atendimento in atendimentos_medico:
            paciente_id = atendimento.get("paciente")
            paciente_info = pessoas_dados.get(paciente_id, {})
            prioridade = paciente_info.get("prioridade", "NORMAL")
            
            if prioridade in atendimentos_por_prioridade:
                atendimentos_por_prioridade[prioridade] += 1
            
            # Tempo de espera
            tempo_chegada = paciente_info.get("tempo_chegada", 0)
            inicio_atendimento = atendimento.get("inicio", 0)
            tempo_espera = inicio_atendimento - tempo_chegada
            
            if prioridade in tempos_espera_por_prioridade:
                tempos_espera_por_prioridade[prioridade].append(tempo_espera)
        
        # 6. Horário de pico
        atendimentos_por_hora = {}
        for hora in range(24):
            atendimentos_por_hora[f"{hora:02d}:00"] = 0
        
        for atendimento in atendimentos_medico:
            inicio_atendimento = atendimento.get("inicio", 0)
            hora_inicio = int((inicio_atendimento / 60) % 24)
            hora_key = f"{hora_inicio:02d}:00"
            atendimentos_por_hora[hora_key] = atendimentos_por_hora.get(hora_key, 0) + 1
        
        # Encontrar horário de pico
        horario_pico = max(atendimentos_por_hora.items(), key=lambda x: x[1])[0] if atendimentos_por_hora else "N/A"
        
        # 7. Score composto de desempenho
        if num_atendimentos > 0:
            # Normalizar métricas (0-100)
            score_eficiencia = min(100, eficiencia * 20)  # 5 pacientes/hora = 100
            score_ocupacao = min(100, taxa_ocupacao)  # Já está em porcentagem
            score_correspondencia = min(100, taxa_correspondencia)  # Já está em porcentagem
            
            # Inverter tempo médio (menor tempo = maior score)
            if tempo_medio_consulta > 0:
                score_tempo = max(0, 100 - (tempo_medio_consulta - 10) * 5)  # 10 min = 100, 30 min = 0
            else:
                score_tempo = 0
            
            score_final = (score_eficiencia * 0.3 + 
                          score_ocupacao * 0.2 + 
                          score_correspondencia * 0.3 + 
                          score_tempo * 0.2)
        else:
            score_final = 0
        
        # Armazenar todas as métricas
        metricas_medico = {
            "id": medico_id,
            "nome": medico_nome,
            "especialidade": medico_especialidade,
            "num_atendimentos": num_atendimentos,
            "tempo_total_ocupado": tempo_total_ocupado,
            "eficiencia": eficiencia,
            "taxa_ocupacao": taxa_ocupacao,
            "tempo_medio_consulta": tempo_medio_consulta,
            "desvio_consulta": desvio_consulta,
            "taxa_correspondencia": taxa_correspondencia,
            "atendimentos_por_prioridade": atendimentos_por_prioridade,
            "tempos_espera_por_prioridade": tempos_espera_por_prioridade,
            "atendimentos_por_hora": atendimentos_por_hora,
            "horario_pico": horario_pico,
            "score_desempenho": score_final,
            "atendimentos_detalhados": atendimentos_medico
        }
        
        metricas_medicos.append(metricas_medico)
    
    return metricas_medicos


