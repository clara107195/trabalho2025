def executar_simulacao_automatica():
    sg.theme('TemaClinica')
    
    config_atual = {
        "lambda_chegada": estado_simulacao.get("lambda_chegada", LAMBDA_CHEGADA),
        "tempo_medio_consulta": estado_simulacao.get("tempo_medio_consulta", TEMPO_MEDIO_CONSULTA),
        "tempo_simulacao": estado_simulacao.get("tempo_simulacao", TEMPO_SIMULACAO),
        "num_medicos": len(estado_simulacao.get("medicos", [])),
        "distribuicao": estado_simulacao.get("distribuicao", "exponential"),
        "frequencia_pausa": estado_simulacao.get("medicos", [{}])[0].get("frequencia_pausa", PAUSA_FREQUENCIA) if estado_simulacao.get("medicos") else PAUSA_FREQUENCIA,
        "duracao_pausa": estado_simulacao.get("medicos", [{}])[0].get("duracao_pausa", DURACAO_PAUSA) if estado_simulacao.get("medicos") else DURACAO_PAUSA,
        "num_pausas": estado_simulacao.get("medicos", [{}])[0].get("num_pausas", NUM_PAUSAS) if estado_simulacao.get("medicos") else NUM_PAUSAS,
        "max_pausa_simultanea": estado_simulacao.get("max_pausa_simultanea", MAX_MEDICOS_PAUSA_SIMULTANEA),
        "velocidade": 100.0,
        "tempo_max_espera": estado_simulacao.get("tempo_max_espera", TEMPO_MAX_ESPERA),
        "prob_desistencia": estado_simulacao.get("prob_desistencia", PROB_DESISTENCIA)
    }
    
    if config_atual["num_medicos"] == 0:
        medicos_dataset = carregar_medicos()
        config_atual["num_medicos"] = len(medicos_dataset)
    
    layout = [
        [sg.Text("Simulação Automática em Execução", font=("Helvetica", 16), justification="center", expand_x=True)],
        [sg.HorizontalSeparator()],
        [sg.ProgressBar(100, size=(50,20), key="-PROGRESSO_AUTO-", bar_color=(escuro,claro))],
        [sg.Text("", key="-STATUS_AUTO-", size=(70,1), font=("Helvetica", 10))],
        [sg.Button("Cancelar", size=(12,1), button_color=('white',escuro))]
    ]
    
    window = sg.Window("Simulação Automática", layout, modal=True, finalize=True, keep_on_top=True)
    
    simulacao_concluida = False
    cancelado = False
    
    if inicializar_simulacao(config_atual):
        tempo_inicio = time.time()
        
        incremento_base = 0.5
        velocidade_auto = 200.0
        
        while not cancelado and not simulacao_concluida:
            event, values = window.read(timeout=50)
            
            if event in (sg.WINDOW_CLOSED, "Cancelar"):
                cancelado = True
                estado_simulacao["simulacao_ativa"] = False
            
            if estado_simulacao["simulacao_ativa"] and not cancelado:
                passos_por_frame = 10
                passo_atual = 0
                while passo_atual < passos_por_frame and estado_simulacao["simulacao_ativa"] and not cancelado:
                    atualizar_simulacao(incremento_base)
                    passo_atual = passo_atual + 1
                
                tempo_atual = estado_simulacao["tempo_atual"]
                tempo_total = config_atual["tempo_simulacao"]
                
                if tempo_total > 0:
                    progresso = min(100, int((tempo_atual / tempo_total) * 100))
                    window["-PROGRESSO_AUTO-"].update(progresso)
                
                atendidos = len(estado_simulacao["historico_atendimentos"])
                desistentes = len(estado_simulacao["pacientes_desistentes"])
                fila = tamanho_fila(estado_simulacao["fila_espera"])
                
                status_text = f"Tempo: {tempo_atual:.0f}/{tempo_total} min | Atendidos: {atendidos} | Fila: {fila} | Desistentes: {desistentes}"
                window["-STATUS_AUTO-"].update(status_text)
                
                if not estado_simulacao["simulacao_ativa"] or tempo_atual >= tempo_total:
                    simulacao_concluida = True
            else:
                simulacao_concluida = True
        
        tempo_fim = time.time()
        tempo_execucao = tempo_fim - tempo_inicio
        
    window.close()
    
    if not cancelado and simulacao_concluida and estado_simulacao["tempo_atual"] > 0:
        if estado_simulacao["simulacao_ativa"]:
            estado_simulacao["simulacao_ativa"] = False
            salvar_resultado_simulacao()
        
        tempo_atual = estado_simulacao["tempo_atual"]
        atendidos = len(estado_simulacao["historico_atendimentos"])
        desistentes = len(estado_simulacao["pacientes_desistentes"])
        
        atendimentos_especialidade_correta = 0
        for h in estado_simulacao["historico_atendimentos"]:
            if h.get("especialidade_correta", False):
                atendimentos_especialidade_correta = atendimentos_especialidade_correta + 1
        
        if atendidos > 0:
            taxa_correspondencia = (atendimentos_especialidade_correta / atendidos) * 100
        else:
            taxa_correspondencia = 0
        
        sg.popup(
            f"Simulação Automática Concluída!\n\n"
            f"Tempo execução: {tempo_execucao:.1f} segundos\n"
            f"Tempo simulado: {tempo_atual:.0f} minutos\n"
            f"Pacientes atendidos: {atendidos}\n"
            f"Pacientes desistentes: {desistentes}",
            title="Simulação Concluída"
        )
    elif not cancelado:
        sg.popup("Simulação automática concluída.", title="Concluído")

