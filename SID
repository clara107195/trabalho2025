            # Coletar métricas da especialidade
            eficiencias_esp = [m["eficiencia"] for m in medicos_especialidade]
            tempos_esp = [m["tempo_medio_consulta"] for m in medicos_especialidade]
            correspondencias_esp = [m["taxa_correspondencia"] for m in medicos_especialidade]
            
            # Posição deste médico no ranking
            eficiencias_ordenadas = sorted(eficiencias_esp, reverse=True)
            tempos_ordenados = sorted(tempos_esp)
            correspondencias_ordenadas = sorted(correspondencias_esp, reverse=True)
            
            pos_eficiencia = eficiencias_ordenadas.index(medico["eficiencia"]) + 1
            pos_tempo = tempos_ordenados.index(medico["tempo_medio_consulta"]) + 1
            pos_corresp = correspondencias_ordenadas.index(medico["taxa_correspondencia"]) + 1
            
            # Gráfico de ranking
            metricas_ranking = ['Eficiência', 'Tempo', 'Corresp.']
            posicoes = [pos_eficiencia, pos_tempo, pos_corresp]
            total_medicos = len(medicos_especialidade)
            
            # Converter posições para score (1º = 100, último = 0)
            scores_ranking = [100 - ((pos-1) / (total_medicos-1)) * 100 if total_medicos > 1 else 50 
                            for pos in posicoes]
            
            bars5 = ax5.bar(metricas_ranking, scores_ranking, color=['blue', 'green', 'red'])
            ax5.set_ylabel('Score Ranking (100 = 1º)')
            ax5.set_title(f'Ranking na {especialidade}\n({total_medicos} médicos)')
            ax5.set_ylim(0, 100)
            ax5.grid(True, alpha=0.3, axis='y')
            
            # Adicionar posição nas barras
            for i, (bar, pos, score) in enumerate(zip(bars5, posicoes, scores_ranking)):
                height = bar.get_height()
                ax5.text(bar.get_x() + bar.get_width()/2., height/2,
                        f'{pos}º/{total_medicos}', ha='center', va='center', 
                        fontsize=10, color='white', fontweight='bold')
        else:
            ax5.text(0.5, 0.5, 'Único médico\nnesta especialidade', 
                    ha='center', va='center', fontsize=12, transform=ax5.transAxes)
            ax5.set_title('Ranking na Especialidade')
            ax5.axis('off')
        
        # 6. Resumo visual
        ax6 = fig.add_subplot(236)
        ax6.axis('off')
        
        # Criar visualização de resumo
        resumo_visual = (
            f"🏥 {medico['nome']}\n"
            f"📋 {medico['especialidade']}\n"
            f"⭐ Score: {medico['score_desempenho']:.0f}/100\n\n"
            f"📊 MÉTRICAS CHAVE:\n"
            f"• {medico['num_atendimentos']} atendimentos\n"
            f"• {medico['eficiencia']:.1f} pacientes/hora\n"
            f"• {medico['tempo_medio_consulta']:.1f} min por consulta\n"
            f"• {medico['taxa_correspondencia']:.1f}% correspondência\n\n"
            f"⏰ HORÁRIO DE PICO:\n"
            f"• {medico['horario_pico']}"
        )
        
        ax6.text(0.1, 0.95, resumo_visual, transform=ax6.transAxes,
                fontsize=10, verticalalignment='top',
                bbox=dict(boxstyle='round', facecolor='lightblue', alpha=0.3))
        
        fig.suptitle(f'Análise de Desempenho - {medico["nome"]}', fontsize=16, fontweight='bold')
        fig.tight_layout(rect=[0, 0, 1, 0.96])
        
        return fig
    
    def criar_grafico_evolucao():
        fig = Figure(figsize=(12, 8), dpi=80)
        
        # Coletar dados temporais dos atendimentos
        atendimentos_ordenados = sorted(medico["atendimentos_detalhados"], 
                                       key=lambda x: x.get("inicio", 0))
        
        if not atendimentos_ordenados:
            ax = fig.add_subplot(111)
            ax.text(0.5, 0.5, 'Sem dados temporais\npara análise', 
                   ha='center', va='center', fontsize=14, transform=ax.transAxes)
            ax.axis('off')
            return fig
        
        # 1. Evolução da eficiência (média móvel)
        ax1 = fig.add_subplot(221)
        
        tempos = [a.get("inicio", 0) for a in atendimentos_ordenados]
        duracoes = [a.get("duracao", 15) for a in atendimentos_ordenados]
        
        # Calcular eficiência em janelas de tempo
        janela_minutos = 60  # 1 hora
        eficiencias_movel = []
        tempos_movel = []
        
        for i in range(len(tempos)):
            tempo_atual = tempos[i]
            tempo_inicio = max(0, tempo_atual - janela_minutos)
            
            # Contar atendimentos na janela
            atendimentos_janela = sum(1 for t in tempos 
                                     if tempo_inicio <= t <= tempo_atual)
            
            # Calcular tempo total na janela
            if atendimentos_janela > 0:
                eficiencia = atendimentos_janela / (janela_minutos / 60)
            else:
                eficiencia = 0
            
            eficiencias_movel.append(eficiencia)
            tempos_movel.append(tempo_atual)
        
        ax1.plot(tempos_movel, eficiencias_movel, 'b-', linewidth=2)
        ax1.set_xlabel('Tempo (min)')
        ax1.set_ylabel('Eficiência (pacientes/hora)')
        ax1.set_title('Evolução da Eficiência (média móvel 1h)')
        ax1.grid(True, alpha=0.3)
        
        # Adicionar média
        if eficiencias_movel:
            media_eficiencia = np.mean(eficiencias_movel)
            ax1.axhline(y=media_eficiencia, color='r', linestyle='--', 
                       alpha=0.7, label=f'Média: {media_eficiencia:.1f}')
            ax1.legend()
        
        # 2. Duração das consultas ao longo do tempo
        ax2 = fig.add_subplot(222)
        
        ax2.scatter(tempos, duracoes, alpha=0.6, s=50, color='green')
        ax2.set_xlabel('Tempo (min)')
        ax2.set_ylabel('Duração (min)')
        ax2.set_title('Duração das Consultas ao Longo do Tempo')
        ax2.grid(True, alpha=0.3)
        
        # Adicionar linha de tendência
        if len(tempos) > 1:
            z = np.polyfit(tempos, duracoes, 1)
            p = np.poly1d(z)
            ax2.plot(tempos, p(tempos), "r--", alpha=0.8, 
                    label=f'Tendência: {z[0]:.3f}x + {z[1]:.1f}')
            ax2.legend()
        
        # 3. Acumulado de atendimentos
        ax3 = fig.add_subplot(223)
        
        acumulado = list(range(1, len(atendimentos_ordenados) + 1))
        
        ax3.plot(tempos, acumulado, 'g-', linewidth=2)
        ax3.set_xlabel('Tempo (min)')
        ax3.set_ylabel('Atendimentos Acumulados')
        ax3.set_title('Progressão dos Atendimentos')
        ax3.grid(True, alpha=0.3)
        
        # 4. Distribuição por hora do dia
        ax4 = fig.add_subplot(224)
        
        horas = [int((t / 60) % 24) for t in tempos]
        horas_contagem = {}
        
        for hora in horas:
            horas_contagem[hora] = horas_contagem.get(hora, 0) + 1
        
        horas_ordenadas = sorted(horas_contagem.items())
        horas_x = [h for h, _ in horas_ordenadas]
        contagens = [c for _, c in horas_ordenadas]
        
        bars4 = ax4.bar(horas_x, contagens, color='purple', edgecolor='black')
        ax4.set_xlabel('Hora do Dia')
        ax4.set_ylabel('Número de Atendimentos')
        ax4.set_title('Distribuição por Hora do Dia')
        ax4.set_xticks(range(0, 24, 3))
        ax4.grid(True, alpha=0.3, axis='y')
        
        # Destacar hora de pico
        if contagens:
            hora_pico_idx = contagens.index(max(contagens))
            bars4[hora_pico_idx].set_color('red')
        
        fig.suptitle(f'Evolução Temporal - {medico["nome"]}', fontsize=16, fontweight='bold')
        fig.tight_layout(rect=[0, 0, 1, 0.96])
        
        return fig
    
