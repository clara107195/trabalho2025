        ax6.text(0.1, 0.95, resumo_texto, transform=ax6.transAxes,
                fontsize=9, verticalalignment='top',
                bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))
        
        fig.suptitle(f'Análise Detalhada - {medico["nome"]}', fontsize=16, fontweight='bold')
        fig.tight_layout(rect=[0, 0, 1, 0.96])
        
        return fig
    
    # Inicializar interface
    atualizar_tabela_resumo()
    atualizar_rankings()
    
    # Criar gráfico de comparação inicial
    fig_comparacao = criar_grafico_comparacao("Todas")
    canvas_comparacao = fig_tk.FigureCanvasTkAgg(fig_comparacao, window["-CANVAS_COMPARACAO-"].TKCanvas)
    canvas_comparacao.draw()
    canvas_comparacao.get_tk_widget().pack(side='top', fill='both', expand=1)
    
    # Variáveis de estado
    medico_selecionado_idx = None
    fig_analise_atual = None
    canvas_analise_atual = None
    
    continuar = True
    while continuar:
        event, values = window.read()
        
        if event in (sg.WINDOW_CLOSED, "-FECHAR-"):
            continuar = False
        
        elif event == "-TABELA_RESUMO-":
            if values["-TABELA_RESUMO-"]:
                medico_selecionado_idx = values["-TABELA_RESUMO-"][0]
                
                # Atualizar análise detalhada
                if medico_selecionado_idx is not None:
                    # Limpar canvas anterior
                    if canvas_analise_atual:
                        canvas_analise_atual.get_tk_widget().destroy()
                    
                    # Criar nova análise
                    fig_analise = criar_analise_detalhada(medico_selecionado_idx)
                    if fig_analise:
                        canvas_analise = fig_tk.FigureCanvasTkAgg(fig_analise, window["-CANVAS_ANALISE-"].TKCanvas)
                        canvas_analise.draw()
                        canvas_analise.get_tk_widget().pack(side='top', fill='both', expand=1)
                        canvas_analise_atual = canvas_analise
        
        elif event == "-APLICAR_FILTRO-":
            especialidade = values["-ESPECIALIDADE_FILTRO-"]
            
            # Limpar canvas atual
            for widget in window["-CANVAS_COMPARACAO-"].TKCanvas.winfo_children():
                widget.destroy()
            
            # Criar novo gráfico
            fig_nova = criar_grafico_comparacao(especialidade)
            canvas_nova = fig_tk.FigureCanvasTkAgg(fig_nova, window["-CANVAS_COMPARACAO-"].TKCanvas)
            canvas_nova.draw()
            canvas_nova.get_tk_widget().pack(side='top', fill='both', expand=1)
        
        elif event == "-GRAFICOS_DETALHADOS-":
            if medico_selecionado_idx is not None:
                mostrar_graficos_desempenho_individual(medico_selecionado_idx, metricas)
            else:
                sg.popup_error("Selecione um médico na tabela primeiro!", title="Erro")
        
        elif event == "-EXPORTAR_RELATORIO-":
            exportar_relatorio_desempenho(metricas)
        
        elif event == "-ATUALIZAR-":
            # Recarregar métricas
            metricas = calcular_desempenho_medicos()
            if metricas:
                atualizar_tabela_resumo()
                atualizar_rankings()
                sg.popup("Dados atualizados com sucesso!", title="Atualizado")
            else:
                sg.popup_error("Não foi possível atualizar os dados.", title="Erro")
    
    window.close()


def mostrar_graficos_desempenho_individual(medico_idx, metricas):
    """Mostra gráficos detalhados para um médico específico"""
    
    if medico_idx >= len(metricas):
        sg.popup_error("Médico não encontrado!", title="Erro")
        return
    
    medico = metricas[medico_idx]
    sg.theme('TemaClinica')
    
    # Layout com abas para diferentes visualizações
    tab_principal_layout = [
        [sg.Canvas(key="-CANVAS_PRINCIPAL-", size=(1000, 600), pad=(10, 10))]
    ]
    
    tab_evolucao_layout = [
        [sg.Canvas(key="-CANVAS_EVOLUCAO-", size=(1000, 600), pad=(10, 10))]
    ]
    
    tab_detalhes_layout = [
        [sg.Multiline("", size=(80, 25), key="-DETALHES_TEXTO-", 
                     font=("Courier", 10), disabled=True, expand_x=True, expand_y=True)]
    ]
    
    tab_group = sg.TabGroup([
        [sg.Tab('Visão Geral', tab_principal_layout, key='-TAB_PRINCIPAL-'),
         sg.Tab('Evolução Temporal', tab_evolucao_layout, key='-TAB_EVOLUCAO-'),
         sg.Tab('Detalhes', tab_detalhes_layout, key='-TAB_DETALHES-')]
    ], expand_x=True, expand_y=True)
    
    layout = [
        [sg.Text(f"Análise de Desempenho - {medico['nome']}", 
                font=("Helvetica", 16, "bold"), justification="center", expand_x=True, pad=(10, 10))],
        [sg.HorizontalSeparator(pad=(10, 5))],
        [tab_group],
        [sg.Button("Exportar Gráficos", key="-EXPORTAR_GRAFICOS-", 
                  button_color=('white', escuro), size=(18, 1)),
         sg.Button("Fechar", key="-FECHAR-", 
                  button_color=('white', escuro), size=(12, 1))]
    ]
    
    window = sg.Window(f"Desempenho - {medico['nome']}", layout, 
                      modal=True, finalize=True, size=(1100, 750), 
                      resizable=True, keep_on_top=True)
    
    # Funções para criar gráficos
    def criar_grafico_principal():
        fig = Figure(figsize=(12, 8), dpi=80)
        
        # 1. Score geral e componentes
        ax1 = fig.add_subplot(231)
        componentes = ['Eficiência', 'Ocupação', 'Corresp.', 'Tempo']
        pesos = [0.3, 0.2, 0.3, 0.2]
        scores = [
            min(100, medico["eficiencia"] * 20),
            medico["taxa_ocupacao"],
            medico["taxa_correspondencia"],
            max(0, 100 - (medico["tempo_medio_consulta"] - 10) * 5)
        ]
        
        colors = ['skyblue', 'lightcoral', 'lightgreen', 'gold']
        bars = ax1.bar(componentes, scores, color=colors, edgecolor='black')
        ax1.set_ylabel('Score (0-100)')
        ax1.set_title('Componentes do Score')
        ax1.set_ylim(0, 100)
        ax1.grid(True, alpha=0.3, axis='y')
        
        # Adicionar valores nas barras
        for i, (bar, score) in enumerate(zip(bars, scores)):
            height = bar.get_height()
            ax1.text(bar.get_x() + bar.get_width()/2., height + 1,
                    f'{score:.0f}\n({pesos[i]*100:.0f}%)',
                    ha='center', va='bottom', fontsize=9)
        
        # 2. Eficiência vs Tempo médio (scatter com outros médicos)
        ax2 = fig.add_subplot(232)
        
        # Coletar dados de todos os médicos para comparação
        eficiencias = [m["eficiencia"] for m in metricas]
        tempos = [m["tempo_medio_consulta"] for m in metricas]
        nomes = [m["nome"] for m in metricas]
        
        ax2.scatter(eficiencias, tempos, alpha=0.5, color='gray', s=50)
        
        # Destacar o médico atual
        idx_medico = next(i for i, m in enumerate(metricas) if m["id"] == medico["id"])
        ax2.scatter(eficiencias[idx_medico], tempos[idx_medico], 
                   color='red', s=150, marker='*', edgecolor='black', linewidth=2)
        
        ax2.set_xlabel('Eficiência (pacientes/hora)')
        ax2.set_ylabel('Tempo Médio (min)')
        ax2.set_title('Eficiência vs Tempo Médio')
        ax2.grid(True, alpha=0.3)
        
        # Adicionar linha de referência
        if eficiencias and tempos:
            ax2.axvline(x=np.mean(eficiencias), color='blue', linestyle='--', alpha=0.5, label='Média eficiência')
            ax2.axhline(y=np.mean(tempos), color='green', linestyle='--', alpha=0.5, label='Média tempo')
            ax2.legend(fontsize=8)
        
        # 3. Taxa de correspondência por prioridade
        ax3 = fig.add_subplot(233)
        
        # Calcular taxa de correspondência por prioridade
        prioridades = ["URGENTE", "ALTA", "NORMAL", "BAIXA"]
        taxas_corresp_prior = []
        
        pessoas_dados = estado_simulacao.get("pessoas_dados", {})
        historico_atendimentos = estado_simulacao.get("historico_atendimentos", [])
        
        for prioridade in prioridades:
            atendimentos_prior = []
            correspondentes_prior = 0
            
            for atendimento in medico["atendimentos_detalhados"]:
                paciente_id = atendimento.get("paciente")
                paciente_info = pessoas_dados.get(paciente_id, {})
                
                if paciente_info.get("prioridade") == prioridade:
                    atendimentos_prior.append(atendimento)
                    especialidade_necessaria = paciente_info.get("especialidade_necessaria", "Clínica Geral")
                    if medico["especialidade"] == especialidade_necessaria:
                        correspondentes_prior += 1
            
            if atendimentos_prior:
                taxa = (correspondentes_prior / len(atendimentos_prior)) * 100
            else:
                taxa = 0
            
            taxas_corresp_prior.append(taxa)
        
        bars3 = ax3.bar(prioridades, taxas_corresp_prior, color=['red', 'orange', 'blue', 'green'])
        ax3.set_xlabel('Prioridade')
        ax3.set_ylabel('Taxa de Correspondência (%)')
        ax3.set_title('Correspondência por Prioridade')
        ax3.set_ylim(0, 100)
        ax3.grid(True, alpha=0.3, axis='y')
        
        # 4. Distribuição do tempo de trabalho
        ax4 = fig.add_subplot(234)
        tempo_atual = estado_simulacao.get("tempo_atual", 480)
        tempo_ocupado = medico["tempo_total_ocupado"]
        tempo_disponivel = max(0, tempo_atual - tempo_ocupado)
        
        labels = ['Ocupado', 'Disponível']
        sizes = [tempo_ocupado, tempo_disponivel]
        colors_pie = ['lightcoral', 'lightgreen']
        
        ax4.pie(sizes, labels=labels, colors=colors_pie, autopct='%1.1f%%', startangle=90)
